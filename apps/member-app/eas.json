{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app-tgseccsl-staging.azurewebsites.net",
        "EXPO_PUBLIC_DEMO_TOOLS": "0"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app-tgseccsl-production.azurewebsites.net",
        "EXPO_PUBLIC_DEMO_TOOLS": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
