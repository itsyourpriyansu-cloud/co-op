# Default server for the app. On a real phone use your laptop's Wi-Fi address
# (printed by `npm run demo`). It can also be changed inside the app: long-press
# the logo on the Welcome screen → Demo settings.
# Android emulator → host machine: http://10.0.2.2:4100 (the backend; the mock API demo uses :4000)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4100
# Staff print pages open the console in the phone's browser (D-106).
# Leave unset locally: the app uses the API's host on port 5180.
# EXPO_PUBLIC_CONSOLE_URL=https://console.example.org
