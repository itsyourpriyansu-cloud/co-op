# Mock API settings (all optional). Defaults suit `npm run demo` on a laptop.
# When hosted (e.g. Azure App Service), the platform usually sets PORT for you.
PORT=4000
HOST=0.0.0.0
# Simulated network delay in ms ("min-max", or 0 for none)
MOCK_LATENCY=200-600
# Keep demo changes across restarts (1) or start fresh every time (0)
MOCK_PERSIST=1
MOCK_DATA_DIR=.data
# Hosted only: comma-separated browser origins allowed to call the API (default: any)
# CORS_ORIGIN=https://tgseccsl-console.azurewebsites.net
