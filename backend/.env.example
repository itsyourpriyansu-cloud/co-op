# Copy to backend/.env and fill in. backend/.env is git-ignored. See docs/22-backend-plan.md §3.

# Required: local PostgreSQL (pgAdmin). Production: Azure Database for PostgreSQL, from Key Vault.
DATABASE_URL=postgres://<user>:<password>@localhost:5432/tgseccsl_dev
# Used only by `npm test -w @tgs/backend`. Wiped and re-migrated on every run.
TEST_DATABASE_URL=postgres://<user>:<password>@localhost:5432/tgseccsl_test

# Optional (defaults shown)
# NODE_ENV=development
# PORT=4100
# HOST=0.0.0.0
# LOG_LEVEL=info
# CORS_ORIGIN=            comma-separated origins; empty = any origin (development only)
# DATABASE_SSL=false      true on Azure

# ---- P1 auth (docs/22 §5.1) ----
# Required in production (32+ characters each). Development uses fixed dev values when empty.
# JWT_SECRET=
# DATA_ENCRYPTION_KEY=
# G1: largest document upload in bytes (default 2 MB; the app shrinks photos to about 150-400 KB first, D-122).
# DOCUMENT_MAX_BYTES=2097152
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30        members
# STAFF_REFRESH_TOKEN_TTL_DAYS=7   G4: staff sign-ins lapse after a week without use
# OTP_TTL_SECONDS=300
# TOTP_ROLES=SUPER_ADMIN,SECRETARY,PRESIDENT
# DEMO_MODE=true          persona sign-in + OTP 123456; always off in production
# SEED_STAFF_PASSWORD=Society@2026   password given to the seeded demo staff
# ---- F-10 outside messaging (D-093, G5 D-115). "simulated" logs instead of sending ----
WHATSAPP_PROVIDER=simulated
# WHATSAPP_FROM=+91XXXXXXXXXX   the society's WhatsApp Business number (shown in logs only)
# WHATSAPP_PROVIDER=meta        send through the WhatsApp Cloud API; needs the two lines below
# WHATSAPP_PHONE_NUMBER_ID=     from Meta Business > WhatsApp > API setup
# WHATSAPP_TOKEN=               a permanent system-user token (Key Vault in production)
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_NOTICE_TEMPLATE=society_notice   approved Utility template, body "{{1}}: {{2}}"
# WHATSAPP_OTP_TEMPLATE=login_code          approved Authentication template with a copy-code button
# WHATSAPP_LANGUAGE=en
# G9: delivery and read receipts. In Meta > WhatsApp > Configuration set the callback URL to
#   https://<api host>/api/v1/webhooks/whatsapp, the verify token below, and subscribe to "messages".
# WHATSAPP_APP_SECRET=          Meta app > Settings > Basic > App secret (Key Vault in production)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN= any long random text, typed again in Meta's webhook setup
EMAIL_PROVIDER=simulated
# EMAIL_FROM=office@example.org   the society's sender address
# EMAIL_PROVIDER=acs            send through Azure Communication Services (managed identity); needs ACS_ENDPOINT and EMAIL_FROM
# ACS_ENDPOINT=https://acs-tgseccsl-production.india.communication.azure.com
# ---- P9 hardening (D-100) ----
# CORS_ORIGIN is required in production: the console and app origins, comma-separated.
# TRUST_PROXY=false         true only behind Azure App Service / a known reverse proxy
# RATE_LIMIT_PER_MINUTE=    per IP on every route; production default 600, 0 = off
# ---- G3 platform (D-113) ----
# FILE_STORE=database       or azure-blob: encrypted bytes in Blob Storage, signed in with the managed identity (no keys)
# AZURE_STORAGE_ACCOUNT=    required when FILE_STORE=azure-blob
# AZURE_STORAGE_CONTAINER=files
# AZURE_CLIENT_ID=          only for a user-assigned identity
# First Super Admin, used by `npm run db:bootstrap` (the container runs it after the migrations)
# only while no active Super Admin exists. Must change the password at first sign-in. Remove after.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# ---- G4 store release (D-114) ----
# PUSH_PROVIDER=simulated   or expo: push notifications through the Expo push service
# EXPO_ACCESS_TOKEN=        only if "enhanced push security" is on for the Expo project
# Apple / Google reviewers: one fictional member's 10-digit mobile and a fixed 6-digit code (never sent). Remove after review.
# STORE_REVIEW_MOBILE=
# STORE_REVIEW_OTP=
# ---- G8 key rotation (D-118) ----
# NEW_DATA_ENCRYPTION_KEY=   only while running `npm run db:rotate-key` (docs/runbook.md §6); never left set
