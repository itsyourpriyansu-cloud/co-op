# Copy to backend/.env and fill in. backend/.env is git-ignored. See docs/22-backend-plan.md §3.

# Required: local PostgreSQL (pgAdmin). Production: Azure Database for PostgreSQL, from Key Vault.
DATABASE_URL=postgres://<user>:<password>@localhost:5432/tgseccsl_dev
# Used only by `npm test -w @tgs/backend`. Wiped and re-migrated on every run.
TEST_DATABASE_URL=postgres://<user>:<password>@localhost:5432/tgseccsl_test

# Optional (defaults shown)
# NODE_ENV=development
# PORT=4100
# HOST=0.0.0.0
# LOG_LEVEL=info
# CORS_ORIGIN=            comma-separated origins; empty = any origin (development only)
# DATABASE_SSL=false      true on Azure

# Dev-only strangler fallback (docs/22 §4): routes the backend does not have yet are
# forwarded to the mock API. Removed in P9. Ignored when NODE_ENV=production.
MOCK_FALLBACK_URL=http://localhost:4000

# ---- P1 auth (docs/22 §5.1) ----
# Required in production (32+ characters each). Development uses fixed dev values when empty.
# JWT_SECRET=
# DATA_ENCRYPTION_KEY=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# OTP_TTL_SECONDS=300
# TOTP_ROLES=SUPER_ADMIN,SECRETARY,PRESIDENT
# DEMO_MODE=true          persona sign-in + OTP 123456; always off in production
# SEED_STAFF_PASSWORD=Society@2026   password given to the seeded demo staff
