# =====================================================================================================
#  TGSECCSL backend settings (environment variables)
# =====================================================================================================
#  HOW TO USE
#    Development : copy this file to backend/.env and fill in the values marked "Dev".
#                  backend/.env is git-ignored: it holds passwords and keys and must never be committed.
#    Production  : do NOT copy a .env file to the server. Set each value in the host's settings
#                  (Azure App Service "Environment variables", Docker -e / env-file, etc.), and keep the
#                  secrets (marked SECRET) in a vault (Azure Key Vault or the host's secret store).
#  The server checks every value when it starts. A wrong or missing value stops it with a clear
#  message naming the setting, instead of failing later (src/config/env.ts).
#
#  Lines starting with "#" are notes or switched-off settings. Remove the "#" to switch one on.
#  A setting that is left out uses the default shown.
#  More detail: docs/22-backend-plan.md §3, docs/runbook.md, docs/go-live-checklist.md.
# =====================================================================================================


# -----------------------------------------------------------------------------------------------------
# 1. SERVER
# -----------------------------------------------------------------------------------------------------

# NODE_ENV: which mode the server runs in.
#   Dev: development. Production: production (always).
#   Why: "production" switches on every safety check: demo sign-in is forced off; JWT_SECRET,
#   DATA_ENCRYPTION_KEY and CORS_ORIGIN become required; rate limits default to 600 a minute; and
#   simulated messages no longer write their text to the log.
NODE_ENV=development

# PORT: the port the API listens on. Dev: 4100 (the console and app expect it). Production: what the host
#   asks for (Azure App Service sets it itself; 4100 in the Docker image).
PORT=4100

# HOST: the network address to listen on. 0.0.0.0 = every address (needed in Docker and Azure). Keep it.
HOST=0.0.0.0

# LOG_LEVEL: how much the server writes to its log: fatal, error, warn, info, debug, trace, silent.
#   Dev: info (debug when chasing a problem). Production: info. Never debug or trace in production:
#   they log far more and can slow the server down.
LOG_LEVEL=info


# -----------------------------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------------------------------

# DATABASE_URL: REQUIRED. SECRET (it holds the password). The database holding all society data.
#   Dev: your local PostgreSQL, database tgseccsl_dev.
#   Production: Azure Database for PostgreSQL (or any managed PostgreSQL), from the vault.
DATABASE_URL=postgres://<user>:<password>@localhost:5432/tgseccsl_dev

# TEST_DATABASE_URL: Dev only. The database the backend tests use (npm test -w @tgs/backend).
#   It is WIPED and rebuilt on every test run, so it must be a separate database named tgseccsl_test.
#   Production: leave it out.
TEST_DATABASE_URL=postgres://<user>:<password>@localhost:5432/tgseccsl_test

# DATABASE_SSL: encrypt the connection to the database.
#   Dev: false (local PostgreSQL has no TLS). Production: true (Azure PostgreSQL requires it).
DATABASE_SSL=false


# -----------------------------------------------------------------------------------------------------
# 3. SECURITY AND SIGN-IN
# -----------------------------------------------------------------------------------------------------

# JWT_SECRET: SECRET, 32+ characters. Signs every sign-in token. Anyone who has it could sign in as anyone.
#   Dev: may be left empty (a fixed development value is used).
#   Production: REQUIRED. A long random value from the vault (e.g. `openssl rand -base64 48`).
#   Changing it signs everybody out (they simply sign in again).
# JWT_SECRET=

# DATA_ENCRYPTION_KEY: SECRET, 32+ characters. Encrypts what is stored for every user: authenticator
#   keys, signatures and uploaded documents.
#   Dev: may be left empty (a fixed development value is used).
#   Production: REQUIRED. A long random value from the vault, set ONCE. Never change it by hand: data
#   encrypted with the old key can no longer be read. To change it, use NEW_DATA_ENCRYPTION_KEY (section 11).
#   Keep a copy in a safe place: a lost key means lost signatures and documents.
# DATA_ENCRYPTION_KEY=

# CORS_ORIGIN: the web addresses allowed to call the API, comma-separated, e.g.
#   https://console.tgseccsl.in,https://app.tgseccsl.in
#   Dev: leave empty (any origin may call; convenient on localhost).
#   Production: REQUIRED. Exactly the console's (and web app's) addresses. Stops other websites from
#   using a signed-in staff member's browser to call the API.
# CORS_ORIGIN=

# TOTP_ROLES: staff roles that must enter a code from an authenticator app at sign-in (D-127: all of them).
#   Dev and production: keep every role. Removing one weakens that role's sign-in.
TOTP_ROLES=SUPER_ADMIN,ACCOUNTANT,SECRETARY,PRESIDENT,CASHIER,DDO

# ACCESS_TOKEN_TTL_SECONDS: how long one sign-in token lasts before the app renews it quietly.
#   Default 900 (15 minutes). Keep it short: a stolen token is soon useless.
ACCESS_TOKEN_TTL_SECONDS=900

# REFRESH_TOKEN_TTL_DAYS: members stay signed in on their phone for this many days without opening the app.
REFRESH_TOKEN_TTL_DAYS=30

# STAFF_REFRESH_TOKEN_TTL_DAYS: staff sign-ins (console and staff screens) end after this many days without use.
STAFF_REFRESH_TOKEN_TTL_DAYS=7

# OTP_TTL_SECONDS: how long a member's one-time sign-in code (sent on WhatsApp) stays valid.
#   300 = 5 minutes. Keep it equal to the expiry in Meta's login_code template.
OTP_TTL_SECONDS=300

# DOCUMENT_MAX_BYTES: the largest upload accepted (photo, ID card, order), in bytes. Default 2097152 (2 MB).
#   The app shrinks photos to about 150-400 KB before upload, so 2 MB is plenty.
DOCUMENT_MAX_BYTES=2097152


# -----------------------------------------------------------------------------------------------------
# 4. DEMO DATA AND THE FIRST ADMIN
# -----------------------------------------------------------------------------------------------------

# DEMO_MODE: demo sign-in (pick a persona, fixed code 123456) and the demo reset / clock tools.
#   Dev: true for demos and the end-to-end tests; false to try sign-in the real way.
#   Production: always off (forced off whatever is written here).
DEMO_MODE=true

# SEED_STAFF_PASSWORD: Dev only. The password the demo staff accounts get when demo data is loaded.
#   Production: leave it out (production has no demo data).
# SEED_STAFF_PASSWORD=Society@2026

# BOOTSTRAP_ADMIN_USERNAME / _NAME / _PASSWORD: the very first Super Admin, created by
#   `npm run db:bootstrap` (the Docker container runs it on start) ONLY while no Super Admin exists.
#   They must change the password and set up the authenticator at first sign-in.
#   Production: set these for the first start, then REMOVE all three. Dev: not needed with demo data.
#   SECRET: the password. At least 8 characters with letters and digits (the server refuses a weaker one);
#   longer, with capitals and a symbol, is better.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_NAME=Society Admin
# BOOTSTRAP_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------------------------------
# 5. WHATSAPP (sign-in codes and notices to members)
# -----------------------------------------------------------------------------------------------------

# WHATSAPP_PROVIDER: simulated = nothing is sent, the message is written to the log (safe for development).
#   meta = sent for real through the WhatsApp Cloud API (needs the settings below).
#   Dev: simulated, or meta with Meta's test number to see real messages. Production: meta.
WHATSAPP_PROVIDER=simulated

# WHATSAPP_FROM: the society's WhatsApp Business number, e.g. +91XXXXXXXXXX. Shown in logs only.
# WHATSAPP_FROM=

# WHATSAPP_PHONE_NUMBER_ID: REQUIRED for meta. Meta Business > WhatsApp > API setup > "Phone number ID".
# WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_TOKEN: REQUIRED for meta. SECRET. A PERMANENT system-user token (Meta Business Settings >
#   System users). The temporary token on the API setup page expires in 24 hours: use it for a quick
#   test only.
# WHATSAPP_TOKEN=

# WHATSAPP_API_VERSION: the Meta Graph API version. Keep v21.0 unless Meta retires it.
WHATSAPP_API_VERSION=v21.0

# WHATSAPP_NOTICE_TEMPLATE: the approved "Utility" template every notice goes out in. Two body values,
#   {{1}} the title and {{2}} the text, with fixed words around them (Meta refuses a body that starts or
#   ends with a value), e.g.
#   "Dear Member, an update on your TGSECCSL account. {{1}}: {{2}} For details, open the TGSECCSL app or contact the society office."
WHATSAPP_NOTICE_TEMPLATE=society_notice

# WHATSAPP_OTP_TEMPLATE: the approved "Authentication" template for sign-in codes (copy-code button,
#   5-minute expiry). Meta does not allow codes in any other template.
WHATSAPP_OTP_TEMPLATE=login_code

# WHATSAPP_LANGUAGE: the language code the templates were approved in: en or en_US. Must match Meta exactly.
WHATSAPP_LANGUAGE=en

# WHATSAPP_APP_SECRET / WHATSAPP_WEBHOOK_VERIFY_TOKEN: delivery and "read" ticks from Meta.
#   Needs a public https address, so: Dev: leave both empty. Production: set both, then in Meta >
#   WhatsApp > Configuration enter the callback URL https://<api host>/api/v1/webhooks/whatsapp, the same
#   verify token, and subscribe to "messages".
#   WHATSAPP_APP_SECRET: SECRET. Meta app > Settings > Basic > App secret. Proves each call really came from Meta.
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN: any long random text you make up; typed again in Meta's webhook setup.
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=


# -----------------------------------------------------------------------------------------------------
# 6. EMAIL (notices to members, applicants and staff, in the designed HTML layout)
# -----------------------------------------------------------------------------------------------------

# EMAIL_PROVIDER: simulated = nothing is sent, written to the log only.
#   smtp = any mail server, on any host: Gmail, the society's own domain mail, Amazon SES, SendGrid, ...
#   acs  = Azure Communication Services (only when running on Azure; signs in with the app's managed identity).
#   Dev: simulated, or smtp to see real emails. Production: smtp (or acs on Azure).
#   Tests and the end-to-end suite always use simulated, whatever is set here.
EMAIL_PROVIDER=simulated

# EMAIL_FROM: REQUIRED for smtp and acs. The sender people see, e.g. TGSECCSL <office@example.org>.
#   With smtp it must be the SMTP account's own address (Gmail replaces any other).
# EMAIL_FROM=

# SMTP_HOST / SMTP_PORT / SMTP_SECURE: the mail server. REQUIRED for smtp.
#   Gmail: smtp.gmail.com, 465, true.  Most others: their host, 587, false (STARTTLS).
#   SMTP_SECURE=true means TLS from the start (port 465); false means STARTTLS (port 587).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# SMTP_USER / SMTP_PASSWORD: REQUIRED for smtp. The mail account that sends. SMTP_PASSWORD is SECRET.
#   Gmail: an "app password" (Google account > Security > 2-Step Verification > App passwords), not the
#   normal password; the spaces Gmail shows may be kept. Revoke it when moving to the domain mail.
# SMTP_USER=
# SMTP_PASSWORD=

# ACS_ENDPOINT: REQUIRED for acs. The Azure Communication Services address
#   (the Azure deployment, infra/main.bicep, fills it in), e.g.
#   https://acs-tgseccsl-production.india.communication.azure.com
# ACS_ENDPOINT=


# -----------------------------------------------------------------------------------------------------
# 7. PUSH NOTIFICATIONS (to the phone app)
# -----------------------------------------------------------------------------------------------------

# PUSH_PROVIDER: simulated = written to the log only.
#   fcm = Android phones through Firebase Cloud Messaging; iPhones through the Expo push service (Apple).
#   Dev: simulated, or fcm to test on a real phone. Production: fcm.
PUSH_PROVIDER=simulated

# FCM_SERVICE_ACCOUNT_JSON: REQUIRED for fcm. SECRET. The Firebase service-account key file's JSON, on ONE
#   line (Firebase console > Project settings > Service accounts > Generate new private key).
#   See docs/store-release.md §3.
# FCM_SERVICE_ACCOUNT_JSON=

# EXPO_ACCESS_TOKEN: SECRET. Only if "enhanced push security" is switched on for the Expo project (iPhone pushes).
# EXPO_ACCESS_TOKEN=


# -----------------------------------------------------------------------------------------------------
# 8. FILE STORAGE (signatures, photos, ID cards, orders)
# -----------------------------------------------------------------------------------------------------

# FILE_STORE: where uploaded files are kept. Always encrypted with DATA_ENCRYPTION_KEY.
#   database   = inside PostgreSQL. Dev: this. Fine in production for a small society too.
#   azure-blob = Azure Blob Storage (cheaper for many files; signs in with the managed identity, no keys).
FILE_STORE=database

# AZURE_STORAGE_ACCOUNT: REQUIRED for azure-blob. The storage account name.
# AZURE_STORAGE_ACCOUNT=

# AZURE_STORAGE_CONTAINER: the Blob container for the files.
# AZURE_STORAGE_CONTAINER=files

# AZURE_CLIENT_ID: only on Azure with a user-assigned managed identity (the Azure deployment sets it).
#   Empty = the app's system-assigned identity. Used by azure-blob and acs.
# AZURE_CLIENT_ID=


# -----------------------------------------------------------------------------------------------------
# 9. NETWORK PROTECTION
# -----------------------------------------------------------------------------------------------------

# TRUST_PROXY: true ONLY behind a known reverse proxy (Azure App Service, nginx, a load balancer), so the
#   real visitor address is used for the rate limits. Dev: false. If true without a proxy, anyone could
#   fake their address and get past the limits.
TRUST_PROXY=false

# RATE_LIMIT_PER_MINUTE: requests a minute allowed from one address, on every route. 0 = off.
#   Empty = the default: off in development, 600 in production. Sign-in always has its own stricter limit.
# RATE_LIMIT_PER_MINUTE=


# -----------------------------------------------------------------------------------------------------
# 10. APP STORE REVIEW (Apple and Google)
# -----------------------------------------------------------------------------------------------------

# STORE_REVIEW_MOBILE / STORE_REVIEW_OTP: while Apple or Google review the app, their testers sign in as
#   ONE fictional member with no money (created by the Admin): its 10-digit mobile and a fixed 6-digit
#   code, which is never sent. Set both or neither. REMOVE both as soon as the review is approved.
# STORE_REVIEW_MOBILE=
# STORE_REVIEW_OTP=


# -----------------------------------------------------------------------------------------------------
# 11. CHANGING THE ENCRYPTION KEY
# -----------------------------------------------------------------------------------------------------

# NEW_DATA_ENCRYPTION_KEY: SECRET. Set ONLY while running `npm run db:rotate-key`, which re-encrypts
#   everything with this new key (docs/runbook.md §6). Then put the new key in DATA_ENCRYPTION_KEY and
#   remove this line. Never leave it set.
# NEW_DATA_ENCRYPTION_KEY=
